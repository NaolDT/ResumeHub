    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.34.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
